    "0 means unlimited. Uses local time; matching start and end means all day. Outside this window, the global limits apply. This does not start paused downloads.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "0 means unlimited. Uses local time; matching start and end means all day. Outside this window, the global limits apply. This does not start paused downloads."
          }
        },
        "zh-Hans": {
