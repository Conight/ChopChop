    "Right-click a link to send it to ChopChop, or open the extension to find media in the current page. Every download opens for review. Cookies and authentication headers are not collected.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right-click a link to send it to ChopChop, or open the extension to find media in the current page. Every download opens for review. Cookies and authentication headers are not collected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键点击链接发送到 ChopChop，或打开扩展查找当前网页中的媒体。每次下载都会先供你确认，不会收集 Cookie 和认证请求头。"
          }
        }
      }
    },
