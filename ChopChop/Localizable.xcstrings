    "\"%@\" will be removed from Aria2 Next. You can keep downloaded files or move the files reported by Aria2 Next to Trash.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" will be removed from Aria2 Next. You can keep downloaded files or move the files reported by Aria2 Next to Trash."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将从 Aria2 Next 移除“%@”。你可以保留下载文件，或将引擎报告的文件移到废纸篓。"
          }
        }
      }
    },
